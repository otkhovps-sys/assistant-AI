# Chọn MỘT trong hai cách kết nối.

# Cách 1 - Gemini Live (nói chuyện thời gian thực). Lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-live
# GEMINI_VOICE=

# Cách 2 - API tương thích OpenAI (chat chữ; giọng nói do cửa sổ Edge nhận và đọc).
# Khi OPENAI_BASE_URL có giá trị, app dùng cách này.
# OPENAI_BASE_URL=https://host/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=
